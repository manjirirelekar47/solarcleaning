# Copy to .env (never commit .env)

# --- broker / database
MQTT_BROKER_HOST=localhost
MQTT_PORT=1883
# leave empty for the anonymous dev broker; set both when using infra/docker-compose.secure.yml
MQTT_USER=
MQTT_PASSWORD=
DB_URL=postgresql+psycopg://solar:solar@localhost:5432/solar

# --- site (Open-Meteo rain forecast). The backend refuses to start at 0,0.
WEATHER_LAT=18.62
WEATHER_LON=73.80
WEATHER_CACHE_S=1800

# --- decision engine
BASELINE_RATIO=1.0        # run tools/calibrate.py with both panels clean
EVAL_INTERVAL_S=10
SETTLE_S=20
RAIN_THRESHOLD_PCT=60
CLEAN_DURATION_S=20
CYCLE_TIMEOUT_S=300
MIN_CLEAN_INTERVAL_S=600
MAX_CLEANS_PER_DAY=6
OFFLINE_AFTER_S=30
CONFIRM_N=3
HYSTERESIS_PCT=1.0
RETRY_WINDOW_S=3600
PAIR_TOLERANCE_S=3.0
TIMEZONE=Asia/Kolkata

# --- vision
MIN_CONF=0.6
MAX_UPLOAD_MB=5
# ALLOW_STUB_DECISIONS=true   # only for simulator demos with no trained model

# --- security: POST /trigger-clean needs this in an X-API-Key header; empty = endpoint refuses.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- alerts and CORS
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ORIGINS=http://localhost:5173
