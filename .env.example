# Copy to .env (never commit .env)

# --- broker / database
MQTT_BROKER_HOST=localhost
MQTT_PORT=1883
# leave empty for the anonymous dev broker; set with infra/docker-compose.secure.yml
MQTT_USER=
MQTT_PASSWORD=
DB_URL=postgresql+psycopg://solar:solar@localhost:5432/solar

# --- site (Open-Meteo rain forecast). The backend refuses to start at 0,0.
WEATHER_LAT=18.62
WEATHER_LON=73.80

# --- decision engine
# run tools/calibrate.py with both panels clean
BASELINE_RATIO=1.0
EVAL_INTERVAL_S=10
SETTLE_S=20
RAIN_THRESHOLD_PCT=60
CLEAN_DURATION_S=20
STALE_CYCLE_S=300
DEVICE_TIMEOUT_S=30

# --- cost / benefit shown on the dashboard (edit to your site)
FARM_RATED_KW=1.0
PEAK_SUN_HOURS=5
TARIFF_INR_PER_KWH=8
CLEANING_COST_INR=10
BENEFIT_HORIZON_DAYS=1

# --- vision
MIN_CONF=0.6
MAX_UPLOAD_MB=5
# ALLOW_STUB_DECISIONS=1     # only for simulator demos with no trained model

# --- security: POST /trigger-clean needs this in an X-API-Key header; empty = endpoint refuses.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
